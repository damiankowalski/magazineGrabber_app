<Window x:Class="MagazineGrabber.LoginWebViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Log in" Height="700" Width="900" WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="16,12" TextWrapping="Wrap"
                   Text="Log in below exactly as you would in your browser. Once you're logged in and the page looks right, click &quot;I'm logged in&quot;."/>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Margin="16,0,16,12">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Padding="8,6" Click="Cancel_Click"/>
            <Button Content="I'm logged in" Width="140" Padding="8,6" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
