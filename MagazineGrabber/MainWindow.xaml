<Window x:Class="MagazineGrabber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magazine Grabber" Height="700" Width="1000" MinHeight="560" MinWidth="820"
        Icon="app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="#F3F3F3">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E4E6EB"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Source URL (empty by default, with an inline hint) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="SourceUrlTextBox" Padding="8" VerticalContentAlignment="Center" Text=""/>
                <!-- Placeholder: visible only while the box is empty; ignores mouse so clicks reach the TextBox. -->
                <TextBlock IsHitTestVisible="False" Foreground="#9AA0A6" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontStyle="Italic"
                           Text="Paste a URL: archive.org/search?query=... , archive.org/details/... , or stare.e-gry.net/czasopisma/...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SourceUrlTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button x:Name="LoadButton" Grid.Column="1" Content="Load list" Click="LoadButton_Click"/>
        </Grid>

        <!-- Item list -->
        <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  ItemsSource="{Binding Items}" Margin="0,0,0,12" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="28" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Progress" Width="130" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Height="14" Margin="4,0" Minimum="0" Maximum="100"
                                         Value="{Binding Progress}"
                                         IsIndeterminate="{Binding IsIndeterminate}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selection + folder -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Select all" Style="{StaticResource SecondaryButton}" Click="SelectAll_Click"/>
            <Button Content="Select none" Style="{StaticResource SecondaryButton}" Click="SelectNone_Click"/>
            <Button Content="Choose download folder..." Style="{StaticResource SecondaryButton}" Click="ChooseFolder_Click"/>
            <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource SecondaryButton}"
                    Click="OpenFolder_Click" IsEnabled="False"/>
            <TextBlock x:Name="FolderPathText" Text="(no folder selected)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555"/>
        </StackPanel>

        <!-- Start + cancel + concurrency + progress -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="StartButton" Content="Start download" Click="StartDownload_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}"
                    Click="CancelButton_Click" IsEnabled="False"/>

            <TextBlock Text="Parallel:" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#555"/>
            <Slider x:Name="ConcurrencySlider" Width="110" Minimum="1" Maximum="5" Value="1"
                    TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    VerticalAlignment="Center"
                    ToolTip="How many items to download at once. 1 = safest / gentlest on the server."/>
            <TextBlock Text="{Binding ElementName=ConcurrencySlider, Path=Value, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" Width="16"/>

            <ProgressBar x:Name="OverallProgressBar" Width="240" Height="22" Margin="12,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressText" Text="0 / 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Log (color-coded; bold = section header; underlined blue = openable file, double-click to open) -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="LogListBox" BorderThickness="0" FontFamily="Consolas" FontSize="11"
                     ItemsSource="{Binding LogEntries}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LogListBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                   ToolTip="{Binding FilePath}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter Property="Foreground" Value="#B7791F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter Property="Foreground" Value="#1E8449"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSection}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#2D6CDF"/>
                                            <Setter Property="Margin" Value="0,6,0,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
